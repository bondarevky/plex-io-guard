  exit "$result"
}
trap pig_finish EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

pig_begin core
/usr/local/libexec/plex-io-guard/plex-io-guard-host remove-core --id plugin-remove-core-2026.11.9-native-updates.1
pig_done
pig_begin helper
/usr/local/libexec/plex-io-guard/plex-io-guard-host remove-helper --id plugin-remove-2026.11.9-native-updates.1
pig_done
pig_begin web
/usr/local/libexec/plex-io-guard/plex-io-guard-host remove-web --id plugin-remove-web-2026.11.9-native-updates.1
pig_done
pig_begin package
/sbin/removepkg plex-io-guard
pig_done
# Preserve cached recovery packages, settings and SSD journals.
</INLINE>
  </FILE>
